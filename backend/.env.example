# Copy to .env and fill in. .env is gitignored.
GOOGLE_CLOUD_PROJECT=care-episode-agent

# Vertex region. Firestore/Cloud Run stay in asia-south1, but the Gemini model
# may only be served from `global` — if you get a 404/NOT_FOUND on the model,
# switch this to: global
GOOGLE_CLOUD_LOCATION=asia-south1

# Fast model for extraction/classification (90% of calls).
# gemini-3.5-flash confirmed served in asia-south1 (Aug 21) — reads a real
# prescription cleanly. Satisfies the hackathon's Gemini 3.5+ requirement.
VERTEX_MODEL_FAST=gemini-3.5-flash

# Smart model — used ONLY for the significance decision (diagnostics agent).
# Never called in a loop. NOTE (Aug 22): gemini-3.5-pro is NOT accessible to this
# project (all regions 404). Using gemini-3.1-pro-preview, which serves on
# `global` only and gives well-calibrated results. The smart call has its own
# region knob because Pro serves from a different region than 3.5-flash.
VERTEX_MODEL_SMART=gemini-3.1-pro-preview
VERTEX_MODEL_SMART_LOCATION=global

# Region the ADK agents use for Vertex (passed per-model, not process-wide).
# All chosen models serve on `global`, so agents run there.
ADK_LOCATION=global

# Places API (New) key — in prod injected from Secret Manager (places-api-key);
# locally, fetch it: gcloud secrets versions access latest --secret=places-api-key
PLACES_API_KEY=

# Demo patient location (Salt Lake, Kolkata). Real system reads patients/{id}.
PATIENT_LAT=22.5808
PATIENT_LNG=88.4258

# Gmail + Calendar OAuth (test-user refresh token; scopes gmail.send + calendar.events).
# Prod: inject the whole secret as OAUTH_CREDENTIALS_JSON (--set-secrets from
# google-oauth-credentials). Local: set the three fields individually.
# Refresh token dies ~7 days in Testing mode — regenerate before the demo.
# OAUTH_CREDENTIALS_JSON=            # {"client_id":...,"client_secret":...,"refresh_token":...}
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REFRESH_TOKEN=

# Where booking-request emails go (demo: send to self so you can show it).
NOTIFY_EMAIL=
