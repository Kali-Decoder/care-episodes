# Care Episode API
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_USE_MOCKS=true

# Google sign-in — copy backend OAUTH_CLIENT_ID (public web client id).
# Never put OAUTH_CLIENT_SECRET or OAUTH_REFRESH_TOKEN here.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional Firebase Auth web app keys (Authentication → Google in Firebase Console)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=care-episode-agent
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
